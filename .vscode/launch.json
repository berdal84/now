    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "task",
            "program": "${workspaceFolder}/task",
            "args": ["help"],
            "cwd": "${workspaceFolder}",
            "terminal": "external",
            "presentation": {
                "revealProblems": "onError",
                "close": true
            }
        },
    ],
    
}